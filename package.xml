<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_s</name>
  <version>0.0.0</version>
  <description>Raspberry Pi stepper motor robot car: motor controller, IMU, magnetometer and keyboard teleop</description>
  <maintainer email="grahamjonesgs@gmail.com">Graham Jones</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <!-- pc_bringup.launch.py, car_guard and the tools also use nav2_bringup,
       nav2_common, robot_localization, slam_toolbox, rviz2 and python3-yaml
       on the PC. They aren't listed, so rosdep doesn't install Nav2 on the
       Pi; install them on the PC as in the README ("Setting up the PC") -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
