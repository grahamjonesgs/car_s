#!/bin/bash
# Run a command with ROS 2 Lyrical, installed natively on an Ubuntu 26.04 host
# (the Beelink), with this workspace's Lyrical build sourced. The Lyrical
# build lives beside the Jazzy one (used by tools/jazzy in the container), in
# ~/ros2_ws/build_lyrical and install_lyrical:
#
#   cd ~/ros2_ws && src/car_s/tools/lyrical colcon --log-base log_lyrical build --symlink-install \
#       --build-base build_lyrical --install-base install_lyrical
#   tools/lyrical ros2 topic list
#   tools/lyrical          # no command: a shell with Lyrical sourced
if [ ! -f /opt/ros/lyrical/setup.bash ]; then
  echo "ROS 2 Lyrical isn't installed here (/opt/ros/lyrical)" >&2
  exit 1
fi
source /opt/ros/lyrical/setup.bash
[ -f ~/ros2_ws/install_lyrical/setup.bash ] && source ~/ros2_ws/install_lyrical/setup.bash
if [ $# -eq 0 ]; then exec bash; fi
exec "$@"
