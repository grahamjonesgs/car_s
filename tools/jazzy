#!/bin/bash
# Run a command with ROS 2 Jazzy, from a host where ROS only exists inside
# the "jazzy" distrobox container (the Beelink, which runs Ubuntu 26.04).
# Sources ROS and the ~/ros2_ws workspace first. With no command, opens an
# interactive shell in the container.
#
#   tools/jazzy ros2 topic list
#   tools/jazzy colcon build --symlink-install --packages-select car_s   # from ~/ros2_ws
#   tools/jazzy ros2 launch car_s pc_bringup.launch.py
#
# Inside the container already (or on a machine with ROS installed
# natively), it just runs the command.
CONTAINER=${JAZZY_CONTAINER:-jazzy}

if [ -f /opt/ros/jazzy/setup.bash ]; then
  source /opt/ros/jazzy/setup.bash
  [ -f ~/ros2_ws/install/setup.bash ] && source ~/ros2_ws/install/setup.bash
  if [ $# -eq 0 ]; then exec bash; fi
  exec "$@"
fi

if ! command -v distrobox >/dev/null; then
  echo "No ROS here and no distrobox to run the '$CONTAINER' container" >&2
  exit 1
fi
# Re-run this script inside the container, in the same directory
exec distrobox enter "$CONTAINER" -- bash -c 'cd "$1" && shift && exec "$@"' _ "$PWD" "$0" "$@"
