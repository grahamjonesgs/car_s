<?xml version="1.0" ?>

<robot name="robot_car">

  <!-- Sizes measured from a top-down photo on A4 paper (2026-10-21), about
       +-1 cm. base_link is midway between the front and rear axles, at axle
       height (0.0325 m above the floor), x forward, y left.
       - The body runs from 0.12 m ahead of base_link to 0.17 m behind it
         (the rear deck overhangs), about 0.18 m wide; 0.22 m wide over the
         wheels.
       - The wheels are 65 mm (0.0325 m radius), 26 mm wide, axles 0.13 m
         apart, centres 0.19 m apart side to side. The controller uses
         calibrated values instead (0.265 m effective spacing for skid steer,
         0.2016 m per revolution).
       - The lidar spin axis is 0.05 m ahead of base_link, centred; its
         height hasn't been measured.
       No colon followed by a space anywhere in this file, as ROS reads
       robot_description passed with -p as YAML and that breaks it.
       The wheel joints are fixed because nothing publishes joint_states, so
       robot_state_publisher can publish their TF. -->

  <link name="base_link">
    <visual>
      <origin xyz="-0.025 0 0.02"/>
      <geometry>
        <box size="0.29 0.18 0.06"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="-0.025 0 0.02"/>
      <geometry>
        <box size="0.29 0.18 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0"
               iyy="0.01" iyz="0"
               izz="0.01"/>
    </inertial>
  </link>

  <link name="left_front_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0002"/>
    </inertial>
  </link>

  <link name="left_rear_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0002"/>
    </inertial>
  </link>

  <link name="right_front_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0002"/>
    </inertial>
  </link>

  <link name="right_rear_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0"
               izz="0.0002"/>
    </inertial>
  </link>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-05" ixy="0" ixz="0"
               iyy="1e-05" iyz="0"
               izz="1e-05"/>
    </inertial>
  </link>

  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0"
               iyy="0.0005" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>

  <joint name="left_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_front_wheel_link"/>
    <origin xyz="0.065 0.095 0" rpy="1.5707 0 0"/>
  </joint>

  <joint name="left_rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_rear_wheel_link"/>
    <origin xyz="-0.065 0.095 0" rpy="1.5707 0 0"/>
  </joint>

  <joint name="right_front_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_front_wheel_link"/>
    <origin xyz="0.065 -0.095 0" rpy="1.5707 0 0"/>
  </joint>

  <joint name="right_rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_rear_wheel_link"/>
    <origin xyz="-0.065 -0.095 0" rpy="1.5707 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.1 0 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- The lidar is mounted with its 0 degree direction facing backwards
         (checked 2026-10-20 with an object in front of the car). Its spin
         axis is 0.05 m ahead of base_link; the height is a guess -->
    <origin xyz="0.05 0 0.1" rpy="0 0 3.14159"/>
  </joint>
</robot>
