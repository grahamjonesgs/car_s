[Unit]
Description=car_s robot (ros2 launch car_s robot_car.launch.py)
After=network-online.target
Wants=network-online.target

[Service]
User=graham
Group=graham
Environment=HOME=/home/graham
# DDS only uses network interfaces that exist at start-up, so wait for WiFi
ExecStartPre=/bin/sh -c 'until ip -4 addr show wlan0 | grep -q inet; do sleep 1; done'
# The Pi has no clock battery: give NTP up to 30 s to set the time, so the
# PC doesn't see stamps from the future, but start anyway without internet
ExecStartPre=-/bin/sh -c 'timeout 30 sh -c "until timedatectl show -p NTPSynchronized --value | grep -q yes; do sleep 1; done"'
# As root (+): set up the kernel PWM for the controller
ExecStartPre=+/home/graham/ros_ws/src/car_s/tools/car_pwm_setup.sh
# ROS 2 Lyrical (Ubuntu 26.04) if it's installed, otherwise Jazzy (24.04)
ExecStart=/bin/bash -c 'source /opt/ros/lyrical/setup.bash 2>/dev/null || source /opt/ros/jazzy/setup.bash; source /home/graham/ros_ws/install/setup.bash && exec ros2 launch car_s robot_car.launch.py'
# SIGINT lets ros2 launch shut the nodes down cleanly (the controller disables the motors)
KillSignal=SIGINT
TimeoutStartSec=120
TimeoutStopSec=20
# However the service ended (including a crashed controller, after which
# the kernel PWM would keep the step pulses running), stop the step pulses
# and disable the drivers (ENABLE, GPIO 14, high)
ExecStopPost=-+/home/graham/ros_ws/src/car_s/tools/car_outputs_off.sh
# A crashed controller ends the launch (on_exit in robot_car.launch.py), and
# ros2 launch then exits 0, so restart on any exit, not only failures
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
